@model MultiShop.Dtos.CommentDtos.CreateCommentDto
@using MultiShop.Dtos.CatalogDtos.ProductDtos
@{
    var product = (UpdateProductDto)ViewData["Product"]!;
    ViewBag.Title = product.ProductName;
    Layout = "_Layout";
    var showReviews = ViewData["ShowReviews"] is true;
}
<link rel="stylesheet" href="~/css/product-detail.css" asp-append-version="true">
<div class="product-detail-page container-fluid pb-5">
    <div class="row px-xl-5"><div class="col-12">
        <nav class="breadcrumb bg-light mb-30" aria-label="Sayfa yolu">
            <a class="breadcrumb-item text-dark" asp-area="" asp-controller="Home" asp-action="Index">Ana sayfa</a>
            <a class="breadcrumb-item text-dark" asp-area="" asp-controller="Product" asp-action="Index">Ürünler</a>
            <span class="breadcrumb-item active">@product.ProductName</span>
        </nav>
    </div></div>
    <div class="row px-xl-5">
        @await Component.InvokeAsync("ProductDetailImages", new { productId = product.ProductId, imageUrl = product.ProductImageUrl })
        @await Component.InvokeAsync("ProductDetailFeature", new { product })
    </div>
    <div class="row px-xl-5"><div class="col">
        <div class="detail-tabs">
            <div class="nav nav-tabs mb-4" role="tablist">
                <a class="nav-item nav-link text-dark @(!showReviews ? "active" : "")" data-toggle="tab" href="#tab-pane-1" role="tab">Açıklama</a>
                <a class="nav-item nav-link text-dark" data-toggle="tab" href="#tab-pane-2" role="tab">Ürün bilgileri</a>
                <a class="nav-item nav-link text-dark @(showReviews ? "active" : "")" data-toggle="tab" href="#tab-pane-3" role="tab">Yorumlar</a>
            </div>
            <div class="tab-content">
                @await Component.InvokeAsync("ProductDetailDescription", new { id = product.ProductId })
                @await Component.InvokeAsync("ProductDetailInformation", new { id = product.ProductId })
                @await Component.InvokeAsync("ProductDetailReview", new { id = product.ProductId, form = Model })
            </div>
        </div>
    </div></div>
</div>
<script src="~/js/product-detail.js" asp-append-version="true" defer></script>
