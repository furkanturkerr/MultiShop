@model MultiShop.WebUI.Models.Product.ProductListViewModel
@using System.Globalization

@{
    var filters = Model.Filters;
}

<aside class="col-lg-3 col-md-4 mb-4">
    <form id="catalog-filters" class="catalog-filter-panel bg-light" asp-area="" asp-controller="Product" asp-action="Index" asp-route-id="" method="get">
        <div class="catalog-filter-heading">
            <h2>Filtreler</h2>
            @if (Model.HasFilters)
            {
                <a asp-area="" asp-controller="Product" asp-action="Index" asp-route-id="">Temizle</a>
            }
        </div>
        <div class="form-group">
            <label for="catalog-query">Ürün ara</label>
            <input id="catalog-query" name="q" type="search" class="form-control" value="@filters.Q" placeholder="Ürün adı yaz" maxlength="200" />
        </div>
        <div class="form-group">
            <label for="catalog-category">Kategori</label>
            <select id="catalog-category" name="categoryId" class="custom-select">
                <option value="">Tüm kategoriler (@Model.CatalogCount)</option>
                @foreach (var category in Model.Categories.OrderBy(category => category.CategoryName))
                {
                    var count = Model.CategoryCounts.GetValueOrDefault(category.CategoryId);
                    <option value="@category.CategoryId" selected="@(category.CategoryId == filters.CategoryId)">@category.CategoryName (@count)</option>
                }
            </select>
        </div>
        <fieldset class="catalog-price-filter">
            <legend>Fiyat aralığı</legend>
            <div class="row mx-n1">
                <div class="col-6 px-1">
                    <label for="catalog-min">En az (₺)</label>
                    <input id="catalog-min" type="number" name="minPrice" min="0" step="0.01" value="@filters.MinPrice?.ToString(CultureInfo.InvariantCulture)" class="form-control" placeholder="0" />
                </div>
                <div class="col-6 px-1">
                    <label for="catalog-max">En çok (₺)</label>
                    <input id="catalog-max" type="number" name="maxPrice" min="0" step="0.01" value="@filters.MaxPrice?.ToString(CultureInfo.InvariantCulture)" class="form-control" placeholder="Üst sınır" />
                </div>
            </div>
        </fieldset>
        <button type="submit" class="btn btn-primary btn-block mt-4">Filtreleri uygula</button>
    </form>
</aside>
