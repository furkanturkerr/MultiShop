@model MultiShop.WebUI.Models.Product.ProductListViewModel

@{
    Layout = "_Layout";
    var filters = Model.Filters;
    var selectedCategory = Model.Categories.FirstOrDefault(category => category.CategoryId == filters.CategoryId);
    var title = selectedCategory?.CategoryName ?? "Tüm Ürünler";
}

<link rel="stylesheet" href="~/css/product-catalog.css" asp-append-version="true" />

<div class="container-fluid catalog-page">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-4" aria-label="Gezinti">
                <a class="breadcrumb-item text-dark" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                @if (selectedCategory is not null)
                {
                    <a class="breadcrumb-item text-dark" asp-area="" asp-controller="Product" asp-action="Index" asp-route-id="">Mağaza</a>
                }
                <span class="breadcrumb-item active" aria-current="page">@title</span>
            </nav>
            <div class="catalog-heading">
                <div>
                    <span class="catalog-eyebrow">MULTISHOP MAĞAZA</span>
                    <h1>@title</h1>
                    <p>İhtiyacına uygun ürünleri keşfet, seçeneklerini daralt.</p>
                </div>
                <span class="catalog-total">@Model.TotalCount ürün</span>
            </div>
        </div>
        <partial name="_Filters" model="Model" />
        <main class="col-lg-9 col-md-8">
            <partial name="_Toolbar" model="Model" />
            <div class="row catalog-grid">
                @await Component.InvokeAsync("ProductList", new { products = Model.Products })
            </div>
            <partial name="_Pagination" model="Model" />
        </main>
    </div>
</div>
