<div class="container-fluid">
    <div class="row bg-secondary py-1 px-xl-5">
        <div class="col-lg-6 d-none d-lg-block">
            <div class="d-inline-flex align-items-center h-100">
                <a class="text-body mr-3" asp-area="" asp-controller="Contact" asp-action="Index">İletişim</a>
                <a class="text-body mr-3" asp-area="User" asp-controller="Order" asp-action="OrderHistory">Siparişlerim</a>
            </div>
        </div>
        <div class="col-lg-6 text-center text-lg-right">
            <div class="d-inline-flex align-items-center">
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-light dropdown-toggle" data-toggle="dropdown">@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Hesabım")</button>
                    <div class="dropdown-menu dropdown-menu-right">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button class="dropdown-item" type="submit">Çıkış yap</button>
                            </form>
                            <a asp-area="User" asp-controller="Order" asp-action="OrderHistory" class="dropdown-item">Tüm Siparişlerim</a>
                            <a asp-area="" asp-controller="Cart" asp-action="Index" class="dropdown-item">Sepetim</a>
                        }
                        else
                        {
                            <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Login">Giriş yap</a>
                            <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Register">Kayıt ol</a>
                        }
                    </div>
                </div>
                <div class="btn-group mx-2">
                    <button type="button" class="btn btn-sm btn-light dropdown-toggle" data-toggle="dropdown">TRY</button>
                    <div class="dropdown-menu dropdown-menu-right">
                        <button class="dropdown-item" type="button">USD</button>
                        <button class="dropdown-item" type="button">EUR</button>
                        <button class="dropdown-item" type="button">GBP</button>
                    </div>
                </div>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-light dropdown-toggle" data-toggle="dropdown">TR</button>
                    <div class="dropdown-menu dropdown-menu-right">
                        <button class="dropdown-item" type="button">EN</button>
                        <button class="dropdown-item" type="button">DE</button>
                        <button class="dropdown-item" type="button">FR</button>
                    </div>
                </div>
            </div>
            <div class="d-inline-flex align-items-center d-block d-lg-none">
                <a asp-area="" asp-controller="Cart" asp-action="Index" class="btn px-0 ml-2" aria-label="Sepetim">
                    <i class="fas fa-shopping-cart text-dark"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="row align-items-center bg-light py-3 px-xl-5 d-none d-lg-flex">
        <div class="col-lg-4">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none">
                <span class="h1 text-uppercase text-primary bg-dark px-2">Multi</span>
                <span class="h1 text-uppercase text-dark bg-primary px-2 ml-n1">Shop</span>
            </a>
        </div>
        <div class="col-lg-4 col-6 text-left">
            <form asp-area="" asp-controller="Product" asp-action="Index" method="get">
                <div class="input-group">
                    <input type="search" name="q" value="@Context.Request.Query["q"]" class="form-control" placeholder="Ürünlerde ara" aria-label="Ürünlerde ara">
                    <div class="input-group-append">
                        <button type="submit" class="input-group-text bg-transparent text-primary" aria-label="Ara">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-lg-4 col-6 text-right">
            <p class="m-0">Müşteri Hizmetleri</p>
            <h5 class="m-0">+90 212 345 67 89</h5>
        </div>
    </div>
</div>

<div class="container-fluid bg-dark mb-30">
    <div class="row px-xl-5">
        @await Component.InvokeAsync("NavbarCategories")

        <div class="col-lg-9">
            <nav class="navbar navbar-expand-lg bg-dark navbar-dark py-3 py-lg-0 px-0">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none d-block d-lg-none">
                    <span class="h1 text-uppercase text-dark bg-light px-2">Multi</span>
                    <span class="h1 text-uppercase text-light bg-primary px-2 ml-n1">Shop</span>
                </a>
                <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
                    <div class="navbar-nav mr-auto py-0">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">Ana Sayfa</a>
                        <a asp-area="" asp-controller="Product" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")">Mağaza</a>

                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">Sayfalar <i class="fa fa-angle-down mt-1"></i></a>
                            <div class="dropdown-menu bg-primary rounded-0 border-0 m-0">
                                <a asp-area="" asp-controller="Cart" asp-action="Index" class="dropdown-item">Sepet</a>
                                <a asp-area="" asp-controller="Order" asp-action="Index" class="dropdown-item">Ödeme</a>
                                <a asp-area="User" asp-controller="Order" asp-action="OrderHistory" class="dropdown-item">Siparişlerim</a>
                            </div>
                        </div>

                        <a asp-area="" asp-controller="Contact" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")">İletişim</a>
                    </div>

                    <div class="navbar-nav ml-auto py-0 d-none d-lg-block">
                        <a asp-area="" asp-controller="Cart" asp-action="Index" class="btn px-0 ml-3" aria-label="Sepetim">
                            <i class="fas fa-shopping-cart text-primary"></i>
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </div>
</div>
