@model List<MultiShop.Dtos.CatalogDtos.OfferDiscountDtos.ResultOfferDiscountDto>

<div class="container-fluid pt-5 pb-3">
    <div class="row px-xl-5">
        
        @foreach (var offer in Model)
        {
            <div class="col-md-6">
                <div class="product-offer mb-30" style="height: 300px;">
                    <img class="img-fluid"
                         src="@offer.ImageUrl"
                         alt="@offer.Title">
                    <div class="offer-text">
                        <h6 class="text-white text-uppercase">@offer.SubTitle</h6>
                        <h3 class="text-white mb-3">@offer.Title</h3>
                        <a href="" class="btn btn-primary">@offer.ButtonText</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>