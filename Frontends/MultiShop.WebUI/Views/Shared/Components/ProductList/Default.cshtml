@model List<MultiShop.Dtos.CatalogDtos.ProductDtos.ResultProductDto>
@using System.Globalization

@if (Model.Any())
{
    foreach (var item in Model)
    {
        <div class="col-lg-4 col-sm-6 mb-4" data-product-id="@item.ProductId">
            <article class="product-item bg-light catalog-product h-100">
                <div class="product-img position-relative overflow-hidden">
                    <a asp-area="" asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId" aria-label="@item.ProductName ürününü incele">
                        <img class="img-fluid w-100" src="@item.ProductImageUrl" alt="@item.ProductName" loading="lazy" />
                    </a>
                    <div class="product-action">
                        <a class="btn btn-outline-dark btn-square" asp-area="" asp-controller="Cart" asp-action="AddBasketItem" asp-route-productId="@item.ProductId" aria-label="@item.ProductName ürününü sepete ekle">
                            <i class="fa fa-shopping-cart"></i>
                        </a>
                        <a class="btn btn-outline-dark btn-square" asp-area="" asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId" aria-label="Ürünü incele">
                            <i class="fa fa-search"></i>
                        </a>
                    </div>
                </div>
                <div class="catalog-product-info">
                    @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                    {
                        <p class="catalog-product-category">@item.CategoryName</p>
                    }
                    <a class="catalog-product-name" asp-area="" asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId">@item.ProductName</a>
                    <p class="catalog-product-price" data-price="@item.ProductPrice.ToString(CultureInfo.InvariantCulture)">@item.ProductPrice.ToString("N2", CultureInfo.GetCultureInfo("tr-TR")) <small>₺</small></p>
                    <a class="btn btn-primary btn-block" asp-area="" asp-controller="Cart" asp-action="AddBasketItem" asp-route-productId="@item.ProductId">
                        <i class="fa fa-shopping-cart mr-2"></i>Sepete ekle
                    </a>
                </div>
            </article>
        </div>
    }
}
else
{
    <div class="col-12">
        <div class="bg-light text-center catalog-empty">
            <i class="fa fa-search mb-3" aria-hidden="true"></i>
            <h2>Aradığın ürün bulunamadı</h2>
            <p>Arama kelimesini veya fiyat aralığını değiştirerek tekrar deneyebilirsin.</p>
            <a class="btn btn-primary" asp-area="" asp-controller="Product" asp-action="Index" asp-route-id="">Tüm ürünleri göster</a>
        </div>
    </div>
}
