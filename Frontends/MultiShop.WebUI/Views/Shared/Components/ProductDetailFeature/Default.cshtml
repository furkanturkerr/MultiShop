@model MultiShop.Dtos.CatalogDtos.ProductDtos.UpdateProductDto
<div class="col-lg-7 mb-30">
    <div class="detail-purchase">
        <span class="detail-kicker">MULTISHOP</span>
        <h1>@Model.ProductName</h1>
        <a class="detail-review-link" href="#tab-pane-3">Ürün yorumlarını gör</a>
        <div class="detail-price">@Model.ProductPrice.ToString("N2") <small>₺</small></div>
        <p class="detail-description">@Model.ProductDescription</p>
        @if (TempData["ProductSelectionError"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        <form asp-area="" asp-controller="Cart" asp-action="AddSelectedItem" method="post">
            <input type="hidden" name="ProductId" value="@Model.ProductId">
            @for (var i = 0; i < Model.Options.Count; i++)
            {
                var option = Model.Options[i];
                <fieldset class="detail-options">
                    <legend>@option.Name</legend>
                    <input type="hidden" name="SelectedOptions[@i].Key" value="@option.Name">
                    <div class="detail-option-values">
                        @for (var j = 0; j < option.Values.Count; j++)
                        {
                            <label class="detail-option">
                                <input type="radio" name="SelectedOptions[@i].Value" value="@option.Values[j]" required>
                                <span>@option.Values[j]</span>
                            </label>
                        }
                    </div>
                </fieldset>
            }
            <div class="detail-buy-row">
                <div class="detail-quantity">
                    <button type="button" data-quantity-change="-1" aria-label="Adedi azalt">−</button>
                    <input type="number" name="Quantity" value="1" min="1" max="99" required aria-label="Adet">
                    <button type="button" data-quantity-change="1" aria-label="Adedi artır">+</button>
                </div>
                <button type="submit" class="btn btn-primary detail-add"><i class="fa fa-shopping-cart mr-2"></i>Sepete ekle</button>
            </div>
        </form>
        <div class="detail-service"><span><i class="fa fa-truck"></i> Teslimat adresini ödeme adımında seç</span><span><i class="fa fa-shield-alt"></i> Hesabınla güvenli alışveriş</span></div>
    </div>
</div>
