@model List<string>
<div class="col-lg-5 mb-30">
    <div class="detail-gallery">
        @if (Model.Count == 0)
        {
            <div class="detail-image-empty"><i class="far fa-image"></i><span>Ürün görseli bulunmuyor</span></div>
        }
        else
        {
            <div id="product-carousel" class="carousel slide" data-interval="false">
                <div class="carousel-inner">
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")"><img src="@Model[i]" alt="@ViewBag.Title — görsel @(i + 1)"></div>
                    }
                </div>
                @if (Model.Count > 1)
                {
                    <a class="carousel-control-prev" href="#product-carousel" data-slide="prev" aria-label="Önceki görsel"><i class="fa fa-chevron-left"></i></a>
                    <a class="carousel-control-next" href="#product-carousel" data-slide="next" aria-label="Sonraki görsel"><i class="fa fa-chevron-right"></i></a>
                }
            </div>
            @if (Model.Count > 1)
            {
                <div class="detail-thumbnails">
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        <button type="button" data-target="#product-carousel" data-slide-to="@i" aria-label="@(i + 1). görseli göster"><img src="@Model[i]" alt=""></button>
                    }
                </div>
            }
        }
    </div>
</div>
