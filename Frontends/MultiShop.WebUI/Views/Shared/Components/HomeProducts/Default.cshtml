@model List<MultiShop.Dtos.CatalogDtos.ProductDtos.ResultProductDto>

<style>
    .home-products .product-img img {
        display: block;
        height: 260px;
        object-fit: contain;
        background: #fff;
    }

    @@media (max-width: 575px) {
        .home-products .product-img img {
            height: 220px;
        }
    }
</style>

<div class="container-fluid pt-5 pb-3 home-products">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4">
        <span class="bg-secondary pr-3">Öne Çıkan Ürünler</span>
    </h2>

    <div class="row px-xl-5">
        
        @foreach (var item in Model.Take(8))
        {
            
            decimal x = ((@item.ProductPrice / 100) *15 ) + @item.ProductPrice;
            
        <div class="col-lg-3 col-md-4 col-sm-6 pb-1">
            <div class="product-item bg-light mb-4">
                <div class="product-img position-relative overflow-hidden">
                    <img class="img-fluid w-100"
                         src="@item.ProductImageUrl"
                         alt="@item.ProductName">

                    <div class="product-action">
                        <a class="btn btn-outline-dark btn-square" asp-area="" asp-controller="Cart" asp-action="AddBasketItem" asp-route-productId="@item.ProductId" >
                            <i class="fa fa-shopping-cart"></i>
                        </a>
                        <a class="btn btn-outline-dark btn-square" asp-area="" asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId" aria-label="Ürünü incele">
                            <i class="fa fa-search"></i>
                        </a>
                    </div>
                </div>

                <div class="text-center py-4">
                    <a asp-area="" asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId" class="h6 d-block text-decoration-none text-truncate" title="@item.ProductName">
                        @item.ProductName
                    </a>

                    <div class="d-flex align-items-center justify-content-center mt-2">
                        <h5> @item.ProductPrice ₺</h5>
                        <h6 class="text-muted ml-2">
                            <del>@x</del>
                        </h6>
                    </div>

                    <div class="d-flex align-items-center justify-content-center mb-1">
                        <small class="fa fa-star text-primary mr-1"></small>
                        <small class="fa fa-star text-primary mr-1"></small>
                        <small class="fa fa-star text-primary mr-1"></small>
                        <small class="fa fa-star text-primary mr-1"></small>
                        <small class="fa fa-star text-primary mr-1"></small>
                        <small>(128)</small>
                    </div>
                </div>
            </div>
        </div>
        }


    </div>
</div>
