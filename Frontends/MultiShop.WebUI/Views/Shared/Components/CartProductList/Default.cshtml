@model MultiShop.Dtos.BasketDtos.BasketTotalDto

<form id="cartAjaxTokenForm" class="d-none">
    @Html.AntiForgeryToken()
</form>
<div id="cartAjaxConfig" data-update-url="@Url.Action("UpdateQuantity", "Cart")"></div>

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-8 table-responsive mb-5">
            <table class="table table-light table-borderless table-hover text-center mb-0">
                <thead class="thead-dark">
                <tr>
                    <th>Ürün</th>
                    <th>Fiyat</th>
                    <th>Miktar</th>
                    <th>Toplam</th>
                    <th>Kaldır</th>
                </tr>
                </thead>

                <tbody class="align-middle">


                @foreach (var item in Model.BasketItems)
                {
                    var imageUrl = string.IsNullOrWhiteSpace(item.ProductImageUrl)
                        ? "https://placehold.co/150x150/f8f5ef/8a837a?text=Ürün"
                        : item.ProductImageUrl;

                    <tr data-cart-row="@item.ProductId">
                        <td class="align-middle text-left">
                            <img
                                src="@imageUrl"
                                alt="@item.ProductName"
                                style="width: 55px; height: 55px; object-fit: cover; margin-right: 12px;">
                            @item.ProductName
                        </td>

                        <td class="align-middle">@item.ProductPrice ₺</td>

                        <td class="align-middle">
                            <div class="input-group cart-quantity mx-auto" style="width: 100px;">
                                <div class="input-group-btn">
                                    <button type="button"
                                            class="btn btn-sm btn-primary js-cart-quantity"
                                            data-product-id="@item.ProductId"
                                            data-change="-1"
                                            disabled="@(item.Quantity <= 1 ? "disabled" : null)"
                                            aria-label="Ürün adedini azalt">
                                        <i class="fa fa-minus"></i>
                                    </button>
                                </div>

                                <input type="text"
                                       class="form-control form-control-sm bg-secondary border-0 text-center js-cart-quantity-value"
                                       value="@item.Quantity"
                                       readonly>

                                <div class="input-group-btn">
                                    <button type="button"
                                            class="btn btn-sm btn-primary js-cart-quantity"
                                            data-product-id="@item.ProductId"
                                            data-change="1"
                                            aria-label="Ürün adedini artır">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </td>

                        <td class="align-middle js-cart-line-total">@((item.ProductPrice * item.Quantity).ToString("N0")) ₺</td>

                        <td class="align-middle">
                            <a asp-area="" asp-controller="Cart" asp-action="RemoveBasketItem" asp-route-productId="@item.ProductId" class="btn btn-sm btn-danger">
                                <i class="fa fa-times"></i>
                            </a>
                        </td>
                    </tr>
                }

                </tbody>
            </table>
        </div>

        <div class="col-lg-4">
            <div class="alert alert-danger d-none js-cart-error" role="alert"></div>

            @if (TempData["CartError"] is string cartErrorMessage)
            {
                <div class="alert alert-danger">@cartErrorMessage</div>
            }
            @if (TempData["DiscountSuccess"] is string successMessage)
            {
                <div class="alert alert-success">@successMessage</div>
            }
            @if (TempData["DiscountError"] is string errorMessage)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <form asp-area="" asp-controller="Discount" asp-action="Index" method="post"  class="mb-30">
                <div class="input-group">
                    <input type="text"
                           name="code"
                           class="form-control border-0 p-4"
                           placeholder="Kupon Kodu"
                           required>

                    <div class="input-group-append">
                        <button class="btn btn-primary">
                            Kuponu Uygula
                        </button>
                    </div>
                </div>
            </form>

            <h5 class="section-title position-relative text-uppercase mb-3">
                <span class="bg-secondary pr-3">Sepet Özeti</span>
            </h5>

            <div class="bg-light p-30 mb-5">
                <div class="border-bottom pb-2">

                    <div class="d-flex justify-content-between mb-3">
                        <h6>Ara Toplam</h6>
                        <h6 class="js-cart-subtotal">@Model.TotalPrice.ToString("N0") ₺</h6>
                    </div>

                    @if (Model.DiscountRate > 0)
                    {
                        <div class="d-flex justify-content-between mb-3">
                            <h6 class="font-weight-medium">İndirim (%@Model.DiscountRate)</h6>
                            <h6 class="font-weight-medium text-success js-cart-discount">-@Model.DiscountAmount.ToString("N0") ₺</h6>
                        </div>
                    }

                    <div class="d-flex justify-content-between">
                        <h6 class="font-weight-medium">Kargo</h6>
                        <h6 class="font-weight-medium">Ücretsiz</h6>
                    </div>

                </div>

                <div class="pt-2">

                    <div class="d-flex justify-content-between mt-2">
                        <h5>Toplam</h5>
                        <h5 class="js-cart-total">@Model.TotalPriceAfterDiscount.ToString("N0") ₺</h5>
                    </div>

                    <a asp-area=""
                       asp-controller="Order"
                       asp-action="Index"
                       class="btn btn-block btn-primary font-weight-bold my-3 py-3">
                        Ödemeye Geç
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>
