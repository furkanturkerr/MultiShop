@model List<MultiShop.Dtos.CatalogDtos.FeaturedDtos.ResultFeaturedDto>

@{
    Layout = "_AdminLayout";
}

<section class="ms-page-head">
    <div>
        <span class="ms-kicker">ANA SAYFA YÖNETİMİ</span>
        <h1>Öne Çıkan Özellikler</h1>
        <p>Ana sayfadaki avantaj ve hizmet kartlarını buradan yönet.</p>
    </div>

    <a class="ms-primary"
       asp-area="Admin"
       asp-controller="Featured"
       asp-action="Create">
        <i class="fa-solid fa-plus"></i>
        Yeni Özellik
    </a>
</section>

<section class="ms-card">

    <div class="ms-table-wrap">

        <table class="ms-table">

            <thead>
            <tr>
                <th>İkon</th>
                <th>Başlık</th>
                <th>İkon Sınıfı</th>
                <th>Durum</th>
                <th style="text-align:right">İşlem</th>
            </tr>
            </thead>

            <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        <div class="ms-cell-icon">
                            <i class="@item.Icon"></i>
                        </div>
                    </td>

                    <td>
                        <strong>@item.Title</strong>
                    </td>

                    <td>
                        <span class="ms-code">@item.Icon</span>
                    </td>

                    <td>
                        @if (item.IsActive)
                        {
                            <span class="ms-status on">Aktif</span>
                        }
                        else
                        {
                            <span class="ms-status off">Pasif</span>
                        }
                    </td>

                    <td>
                        <div class="ms-actions">

                            <a class="ms-action"
                               asp-area="Admin"
                               asp-controller="Featured"
                               asp-action="Update"
                               asp-route-id="@item.FeaturedId"
                               title="Düzenle">

                                <i class="fa-regular fa-pen-to-square"></i>

                            </a>

                            <form method="post"
                                  asp-area="Admin"
                                  asp-controller="Featured"
                                  asp-action="Delete"
                                  asp-route-id="@item.FeaturedId"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="ms-action danger"
                                        title="Sil">

                                    <i class="fa-regular fa-trash-can"></i>

                                </button>

                            </form>

                        </div>
                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>

</section>