@model MultiShop.Dtos.CatalogDtos.FeaturedDtos.CreateFeaturedDto

@{
    Layout = "_AdminLayout";
}

<section class="ms-page-head">

    <div>
        <span class="ms-kicker">ÖZELLİK YÖNETİMİ</span>
        <h1>Yeni özellik ekle</h1>
        <p>Ana sayfada gösterilecek avantaj veya hizmet bilgisini oluştur.</p>
    </div>

    <div class="ms-head-actions">

        <a class="ms-secondary"
           asp-area="Admin"
           asp-controller="Featured"
           asp-action="Index">
            Vazgeç
        </a>

        <button class="ms-primary"
                type="submit"
                form="featuredCreateForm">

            <i class="fa-solid fa-check"></i>
            Özelliği Kaydet

        </button>

    </div>

</section>

<form id="featuredCreateForm"
      class="ms-form-layout"
      method="post"
      asp-area="Admin"
      asp-controller="Featured"
      asp-action="Create">

    @Html.AntiForgeryToken()

    <div class="ms-form-stack">

        <section class="ms-card ms-form-card">

            <div class="ms-form-title">
                <h2>Özellik bilgileri</h2>
                <p>Ana sayfada gösterilecek başlık ve ikon bilgisini belirle.</p>
            </div>

            <div class="ms-form-grid">

                <div class="ms-field full">

                    <label asp-for="Title">
                        Başlık
                    </label>

                    <input class="ms-input"
                           asp-for="Title"
                           placeholder="Örn. Ücretsiz Kargo"/>

                </div>

                <div class="ms-field full">

                    <label asp-for="Icon">
                        İkon
                    </label>

                    <input class="ms-input"
                           asp-for="Icon"
                           placeholder="Örn. fa fa-shipping-fast"/>

                    <small>
                        Font Awesome ikon sınıfını gir.
                    </small>

                </div>

            </div>

        </section>

    </div>

    <aside class="ms-form-stack">

        <section class="ms-card ms-form-card">

            <div class="ms-form-title">
                <h2>Önizleme</h2>
                <p>Özellik ana sayfada bu yapıda gösterilir.</p>
            </div>

            <div class="ms-cell">

                <span class="ms-cell-icon"
                      style="width:55px;height:55px;font-size:22px;">

                    <i class="fa fa-check"></i>

                </span>

                <div>
                    <strong>
                        Yeni Özellik
                    </strong>

                    <small>
                        Ana sayfa avantaj alanı
                    </small>
                </div>

            </div>

        </section>

        <section class="ms-card ms-form-card">

            <div class="ms-form-title">
                <h2>Yayın durumu</h2>
                <p>Özelliğin ana sayfada gösterilip gösterilmeyeceğini belirle.</p>
            </div>

            <div class="ms-switch-row">

                <div>
                    <strong>Aktif özellik</strong>
                    <span>Ana sayfada gösterilsin.</span>
                </div>

                <label class="ms-switch">

                    <input asp-for="IsActive"
                           type="checkbox"
                           checked/>

                    <span class="ms-slider"></span>

                </label>

            </div>

        </section>

        <div class="ms-form-footer">

            <a class="ms-secondary"
               asp-area="Admin"
               asp-controller="Featured"
               asp-action="Index">
                Vazgeç
            </a>

            <button class="ms-primary"
                    type="submit">

                <i class="fa-solid fa-check"></i>
                Özelliği Kaydet

            </button>

        </div>

    </aside>

</form>