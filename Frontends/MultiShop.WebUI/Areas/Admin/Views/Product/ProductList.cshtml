@model MultiShop.WebUI.Models.Product.ProductListViewModel

@{
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/admin-products.css" asp-append-version="true">

<div class="ms-product-page">
    <section class="ms-page-head">
        <div>
            <span class="ms-kicker">KATALOG</span>
            <h1>Ürünler</h1>
            <p>Ürünleri, kategorileri ve satış fiyatlarını buradan yönet.</p>
        </div>
        <a class="ms-primary" asp-action="Create">
            <svg class="ms-product-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Yeni ürün
        </a>
    </section>

    <section class="ms-card">
        <form class="ms-toolbar" method="get" asp-action="ProductList">
            <div class="ms-search">
                <svg class="ms-product-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="6.5" />
                    <path d="m16 16 4 4" />
                </svg>
                <input name="q" value="@Model.Filters.Q" type="search"
                       placeholder="Ürün adı veya açıklama ara…" aria-label="Ürün ara">
            </div>
            <select class="ms-select" name="categoryId" aria-label="Kategori">
                <option value="">Tüm kategoriler</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.CategoryId" selected="@(category.CategoryId == Model.Filters.CategoryId)">
                        @category.CategoryName
                    </option>
                }
            </select>
            <select class="ms-select" name="pageSize" aria-label="Sayfadaki ürün sayısı">
                @foreach (var size in new[] { 12, 24, 48 })
                {
                    <option value="@size" selected="@(size == Model.Filters.PageSize)">@size ürün / sayfa</option>
                }
            </select>
            <button type="submit" class="ms-primary">Filtrele</button>
            <a class="ms-secondary" asp-action="ProductList">Temizle</a>
        </form>
        <partial name="_Table" model="Model.Products" />
    </section>

    <partial name="_Pagination" model="Model" />
</div>
