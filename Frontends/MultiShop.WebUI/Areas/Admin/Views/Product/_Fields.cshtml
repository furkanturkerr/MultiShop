@model MultiShop.Dtos.CatalogDtos.ProductDtos.ProductInputDto
@using Microsoft.AspNetCore.Mvc.Rendering
@using MultiShop.WebUI.Models.Product

@{
    var options = (ProductOptionsViewModel)ViewData["ProductOptions"]!;
    var categories = new SelectList(options.Categories, "CategoryId", "CategoryName", Model.CategoryId);
}

<section class="ms-card ms-form-card">
    <div class="ms-form-title">
        <h2><span class="ms-section-number">01</span> Ürün bilgileri</h2>
        <p>Mağazada görünecek adı, kategoriyi ve satış fiyatını belirle.</p>
    </div>

    <div class="ms-form-grid">
        <div class="ms-field full">
            <label asp-for="ProductName">Ürün adı</label>
            <input class="ms-input" asp-for="ProductName" placeholder="Örn. Beyaz günlük sneaker">
            <span asp-validation-for="ProductName"></span>
        </div>
        <div class="ms-field">
            <label asp-for="CategoryId">Kategori</label>
            <select class="ms-form-select" asp-for="CategoryId" asp-items="categories">
                <option value="">Kategori seçin</option>
            </select>
            <span asp-validation-for="CategoryId"></span>
        </div>
        <div class="ms-field">
            <label asp-for="ProductPrice">Satış fiyatı (₺)</label>
            <input class="ms-input" asp-for="ProductPrice" type="number" step="0.01" min="0.01" placeholder="0,00">
            <span asp-validation-for="ProductPrice"></span>
        </div>
        <div class="ms-field full">
            <label asp-for="ProductDescription">Ürün açıklaması</label>
            <textarea class="ms-textarea" asp-for="ProductDescription" rows="6"
                      placeholder="Ürünün malzemesi, kullanım alanı ve öne çıkan özellikleri…"></textarea>
            <span asp-validation-for="ProductDescription"></span>
        </div>
    </div>
</section>
