@model MultiShop.Dtos.CatalogDtos.ProductDtos.CreateProductDto

@{
  Layout = "_AdminLayout";
}

<section class="ms-page-head">
  <div><span class="ms-kicker">ÜRÜN YÖNETİMİ</span>
    <h1>Yeni ürün ekle</h1>
    <p>Ürünün temel bilgilerini, fiyatını ve seçeneklerini oluştur.</p></div>
  <div class="ms-head-actions"><a class="ms-secondary" href="products.html">Vazgeç</a>
    <button class="ms-primary" type="submit" form="productCreateForm"><i class="fa-solid fa-check"></i> Ürünü Kaydet
    </button>
  </div>
</section>

<form id="productCreateForm" class="ms-form-layout" method="post" asp-area="Admin" asp-controller="Product" asp-action="Create">
  
  @Html.AntiForgeryToken()
  
  <div class="ms-form-stack">
    <section class="ms-card ms-form-card">
      <div class="ms-form-title">
        <h2>Temel bilgiler</h2>
        <p>Mağazada müşterilerin göreceği ana ürün bilgileri.</p></div>
      <div class="ms-form-grid">
        <div class="ms-field">
          <label>Ürün Adı</label>
          <input class="ms-input" asp-for="@Model.ProductName" type="text" placeholder="Örn. Nike">
        </div>
        <div class="ms-field full">
          <label>Ürün açıklaması</label>
          <textarea class="ms-textarea" asp-for="@Model.ProductDescription" placeholder="Ürünün detaylı açıklamasını yazın..."></textarea>
        </div>
        
        <div class="ms-field">
          <label>Kategori</label>
          <select class="ms-form-select" asp-for="@Model.CategoryId" asp-items="@ViewBag.Category">
            <option value="">Kategori seçin</option>
          </select>
        </div>
      </div>
    </section>

    <section class="ms-card ms-form-card">
      <div class="ms-form-title">
        <h2>Fiyatlandırma</h2>
        <p>Ürünün satış fiyatını ve varsa eski fiyatını belirle.</p></div>
      <div class="ms-form-grid">
        <div class="ms-field">
          <label>Satış fiyatı</label>
          <input class="ms-input" asp-for="@Model.ProductPrice" type="number" placeholder="4999">
        </div>
        @* <div class="ms-field"> *@
        @*   <label>Eski fiyat</label><input class="ms-input" type="number" placeholder="5499"> *@
        @*   <small>İndirim göstermek istemiyorsan boş bırak.</small> *@
        @* </div> *@
      </div>
    </section>

