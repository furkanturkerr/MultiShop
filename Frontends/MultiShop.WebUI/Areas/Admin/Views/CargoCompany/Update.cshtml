@model MultiShop.Dtos.CargoDtos.CargoCompanyDtos.UpdateCargoCompanyDto

@{
    ViewData["Title"] = "Kargo Şirketini Güncelle";
    Layout = "_AdminLayout";
}

<section class="ms-page-head">
    <div>
        <span class="ms-kicker">LOJİSTİK YÖNETİMİ</span>
        <h1>Kargo şirketini güncelle</h1>
        <p>Kayıtlı teslimat sağlayıcısının görünen adını düzenle.</p>
    </div>

    <div class="ms-head-actions">
        <a class="ms-secondary" asp-area="Admin" asp-controller="CargoCompany" asp-action="Index">
            Vazgeç
        </a>
        <button class="ms-primary" type="submit" form="cargoCompanyUpdateForm">
            <i class="fa-solid fa-check"></i>
            Değişiklikleri Kaydet
        </button>
    </div>
</section>

<form id="cargoCompanyUpdateForm"
      class="ms-form-layout"
      method="post"
      asp-area="Admin"
      asp-controller="CargoCompany"
      asp-action="Update">
    @Html.AntiForgeryToken()
    <input asp-for="CargoCompanyId" type="hidden">

    <div class="ms-form-stack">
        <section class="ms-card ms-form-card">
            <div class="ms-form-title">
                <h2>Şirket bilgileri</h2>
                <p>Kargo firmasının yönetim ve sipariş ekranlarında görünen adını güncelle.</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="ms-form-grid">
                <div class="ms-field full">
                    <label asp-for="CompanyName">Kargo şirketi adı</label>
                    <input class="ms-input"
                           asp-for="CompanyName"
                           maxlength="100"
                           autocomplete="off">
                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                </div>
            </div>
        </section>
    </div>

    <aside class="ms-form-stack">
        <section class="ms-card ms-form-card">
            <div class="ms-form-title">
                <h2>Kayıt bilgisi</h2>
                <p>Güncellediğin ad mevcut siparişlerdeki şirket seçimini değiştirmez.</p>
            </div>

            <div class="ms-switch-row">
                <div>
                    <strong>Kargo şirketi #@Model.CargoCompanyId</strong>
                    <span>Mevcut teslimat sağlayıcısı</span>
                </div>
            </div>
        </section>

        <div class="ms-form-footer">
            <a class="ms-secondary" asp-area="Admin" asp-controller="CargoCompany" asp-action="Index">
                Vazgeç
            </a>
            <button class="ms-primary" type="submit">
                <i class="fa-solid fa-check"></i>
                Değişiklikleri Kaydet
            </button>
        </div>
    </aside>
</form>
