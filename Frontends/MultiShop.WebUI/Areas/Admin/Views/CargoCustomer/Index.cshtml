@model List<MultiShop.Dtos.OrderDtos.OrderAddressDtos.ResultOrderAddressDto>

@{
    ViewData["Title"] = "Müşteri Adresleri";
    Layout = "_AdminLayout";
    var error = ViewData["LoadError"] as string;
}

<link rel="stylesheet" href="~/css/admin-orders.css" asp-append-version="true">

<div class="ms-orders-page">
    <section class="ms-page-head">
        <div>
            <span class="ms-kicker">MÜŞTERİ İŞLEMLERİ</span>
            <h1>Müşteri adresleri</h1>
            <p>Müşterilerin ödeme adımında kaydettiği teslimat ve iletişim bilgileri.</p>
        </div>
        <a class="ms-secondary" asp-controller="Order" asp-action="Index">Siparişler</a>
    </section>

    @if (error is not null)
    {
        <p class="ms-load-error" role="alert">@error</p>
    }

    <section class="ms-card">
        <div class="ms-toolbar"><strong>Kayıtlı adresler</strong><span class="ms-toolbar-meta">@Model.Count adres</span></div>
        <div class="ms-table-wrap">
            <table class="ms-table">
                <thead>
                    <tr><th>Müşteri</th><th>İletişim</th><th>Şehir / İlçe</th><th>Adres</th><th>Kullanıcı</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Name @item.Surname</strong><small>Adres #@item.AddressId · @item.Description</small></td>
                            <td><strong>@item.Phone</strong><small>@item.Email</small></td>
                            <td><strong>@item.City / @item.District</strong><small>@item.Country</small></td>
                            <td class="ms-order-address">@item.Detail1<br>@item.Detail2</td>
                            <td><span class="ms-code" title="@item.UserId">@(item.UserId.Length > 10 ? item.UserId[..10] + "…" : item.UserId)</span></td>
                        </tr>
                    }
                    @if (Model.Count == 0 && error is null)
                    {
                        <tr><td colspan="5" class="ms-empty-state">Henüz kayıtlı müşteri adresi bulunmuyor.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
