@model MultiShop.Dtos.DiscountDtos.CreateCouponDto

@{
    Layout = "_AdminLayout";
}

<section class="ms-page-head">
    <div>
        <span class="ms-kicker">KUPON YÖNETİMİ</span>
        <h1>Yeni kupon ekle</h1>
        <p>Sepette kullanılacak kodu, indirim oranını ve kullanım süresini belirle.</p>
    </div>
    <div class="ms-head-actions">
        <a class="ms-secondary" asp-area="Admin" asp-controller="Coupon" asp-action="Index">Vazgeç</a>
        <button class="ms-primary" type="submit" form="couponCreateForm">
            <i class="fa-solid fa-check"></i> Kuponu Kaydet
        </button>
    </div>
</section>

<form id="couponCreateForm"
      class="ms-form-layout"
      method="post"
      asp-area="Admin"
      asp-controller="Coupon"
      asp-action="Create">
    @Html.AntiForgeryToken()

    <div class="ms-form-stack">
        <section class="ms-card ms-form-card">
            <div class="ms-form-title">
                <h2>Kupon bilgileri</h2>
                <p>Kullanıcının sepette yazacağı kodu ve uygulanacak yüzdeyi gir.</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="ms-form-grid">
                <div class="ms-field">
                    <label asp-for="Code">Kupon kodu</label>
                    <input class="ms-input" asp-for="Code" placeholder="Örn. YENI20" autocomplete="off">
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="ms-field">
                    <label asp-for="Rate">İndirim oranı (%)</label>
                    <input class="ms-input" asp-for="Rate" type="number" min="1" max="100" placeholder="20">
                    <span asp-validation-for="Rate" class="text-danger"></span>
                </div>
                <div class="ms-field full">
                    <label asp-for="ValidDate">Geçerlilik tarihi</label>
                    <input class="ms-input" asp-for="ValidDate" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local">
                    <span asp-validation-for="ValidDate" class="text-danger"></span>
                </div>
            </div>
        </section>
    </div>

    <aside class="ms-form-stack">
        <section class="ms-card ms-form-card">
            <div class="ms-form-title">
                <h2>Kullanım durumu</h2>
                <p>Pasif kuponlar doğru kod girilse bile sepette uygulanmaz.</p>
            </div>
            <div class="ms-switch-row">
                <div>
                    <strong>Aktif kupon</strong>
                    <span>Sepette kullanılabilsin.</span>
                </div>
                <label class="ms-switch">
                    <input asp-for="IsActive" type="checkbox">
                    <span class="ms-slider"></span>
                </label>
            </div>
        </section>

        <div class="ms-form-footer">
            <a class="ms-secondary" asp-area="Admin" asp-controller="Coupon" asp-action="Index">Vazgeç</a>
            <button class="ms-primary" type="submit">
                <i class="fa-solid fa-check"></i> Kuponu Kaydet
            </button>
        </div>
    </aside>
</form>
