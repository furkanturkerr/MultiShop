@model MultiShop.Dtos.CatalogDtos.CategoryDtos.UpdateCategoryDto

@{
    Layout = "_AdminLayout";
}

<section class="ms-page-head">
    <div>
        <span class="ms-kicker">KATEGORİ YÖNETİMİ</span>
        <h1>Kategoriyi güncelle</h1>
        <p>Kategori bilgilerini ve görselini düzenleyip kaydet.</p>
    </div>

    <div class="ms-head-actions">

        <a class="ms-secondary"
           asp-area="Admin"
           asp-controller="Category"
           asp-action="Index">
            Vazgeç
        </a>

        <button class="ms-primary"
                type="submit"
                form="categoryUpdateForm">
            <i class="fa-solid fa-check"></i>
            Değişiklikleri Kaydet
        </button>

    </div>
</section>

<form id="categoryUpdateForm"
      class="ms-form-layout"
      method="post"
      asp-area="Admin"
      asp-controller="Category"
      asp-action="Update">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="CategoryId" />

    <div class="ms-form-stack">

        <section class="ms-card ms-form-card">

            <div class="ms-form-title">
                <h2>Kategori bilgileri</h2>
                <p>Kategorinin mağazada gösterilen bilgilerini güncelle.</p>
            </div>

            <div class="ms-form-grid">

                <div class="ms-field full">

                    <label asp-for="CategoryName">
                        Kategori adı
                    </label>

                    <input class="ms-input"
                           asp-for="CategoryName"
                           type="text"
                           placeholder="Örn. Ayakkabı" />

                    <span asp-validation-for="CategoryName"
                          class="text-danger"></span>

                </div>

            </div>

        </section>

    </div>

    <aside class="ms-form-stack">

        <section class="ms-card ms-form-card">

            <div class="ms-form-title">
                <h2>Kategori görseli</h2>
                <p>Kategori kartında kullanılan görseli güncelle.</p>
            </div>

            <div class="ms-image-preview @(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "" : "has-image")"
                 data-product-image-preview>

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.CategoryName"
                         style="width:100%; height:240px; object-fit:cover;" />
                }
                else
                {
                    <div class="ms-image-preview-inner">

                        <i class="fa-regular fa-image"></i>

                        <strong>
                            Görsel önizleme
                        </strong>

                        <span>
                            URL girdikten sonra kategori görseli burada görünür.
                        </span>

                    </div>
                }

            </div>

            <div class="ms-field"
                 style="margin-top:12px">

                <label asp-for="ImageUrl">
                    Görsel URL
                </label>

                <input class="ms-input"
                       asp-for="ImageUrl"
                       data-product-image-url
                       type="url"
                       placeholder="https://images.unsplash.com/..." />

                <span asp-validation-for="ImageUrl"
                      class="text-danger"></span>

            </div>

        </section>

        <div class="ms-form-footer">

            <a class="ms-secondary"
               asp-area="Admin"
               asp-controller="Category"
               asp-action="Index">
                Vazgeç
            </a>

            <button class="ms-primary"
                    type="submit">
                <i class="fa-solid fa-check"></i>
                Değişiklikleri Kaydet
            </button>

        </div>

    </aside>

</form>