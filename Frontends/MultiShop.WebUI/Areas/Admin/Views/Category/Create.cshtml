@model MultiShop.Dtos.CatalogDtos.CategoryDtos.CreateCategoryDto

@{
    Layout = "_AdminLayout";
}

<section class="ms-page-head">
    <div>
        <span class="ms-kicker">KATEGORİ YÖNETİMİ</span>
        <h1>Yeni kategori ekle</h1>
        <p>Kategori bilgilerini oluştur ve mağazada kullanılacak görseli belirle.</p>
    </div>

    <div class="ms-head-actions">
        <a class="ms-secondary"
           asp-area="Admin"
           asp-controller="Category"
           asp-action="Index">
            Vazgeç
        </a>

        <button class="ms-primary"
                type="submit"
                form="categoryCreateForm">
            <i class="fa-solid fa-check"></i>
            Kategoriyi Kaydet
        </button>
    </div>
</section>

<form id="categoryCreateForm"
      class="ms-form-layout"
      method="post"
      asp-area="Admin"
      asp-controller="Category"
      asp-action="Create">

    @Html.AntiForgeryToken()

    <div class="ms-form-stack">

        <section class="ms-card ms-form-card">

            <div class="ms-form-title">
                <h2>Kategori bilgileri</h2>
                <p>Kategorinin mağazada gösterilecek temel bilgilerini gir.</p>
            </div>

            <div class="ms-form-grid">

                <div class="ms-field full">
                    <label asp-for="CategoryName">
                        Kategori adı
                    </label>

                    <input class="ms-input"
                           asp-for="CategoryName"
                           type="text"
                           placeholder="Örn. Ayakkabı" />

                    <span asp-validation-for="CategoryName"
                          class="text-danger"></span>
                </div>

            </div>

        </section>

    </div>

    <aside class="ms-form-stack">

        <section class="ms-card ms-form-card">

            <div class="ms-form-title">
                <h2>Kategori görseli</h2>
                <p>Kategori kartında kullanılacak görseli belirle.</p>
            </div>

            <div class="ms-image-preview"
                 data-product-image-preview>

                <div class="ms-image-preview-inner">

                    <i class="fa-regular fa-image"></i>

                    <strong>
                        Görsel önizleme
                    </strong>

                    <span>
                        URL girdikten sonra kategori görseli burada görünür.
                    </span>

                </div>

            </div>

            <div class="ms-field"
                 style="margin-top:12px">

                <label asp-for="ImageUrl">
                    Görsel URL
                </label>

                <input class="ms-input"
                       asp-for="ImageUrl"
                       data-product-image-url
                       type="url"
                       placeholder="https://images.unsplash.com/..." />

                <span asp-validation-for="ImageUrl"
                      class="text-danger"></span>

            </div>

        </section>

        <div class="ms-form-footer">

            <a class="ms-secondary"
               asp-area="Admin"
               asp-controller="Category"
               asp-action="Index">
                Vazgeç
            </a>

            <button class="ms-primary"
                    type="submit">
                <i class="fa-solid fa-check"></i>
                Kategoriyi Kaydet
            </button>

        </div>

    </aside>

</form>