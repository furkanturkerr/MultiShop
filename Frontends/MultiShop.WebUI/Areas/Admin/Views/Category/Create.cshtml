@model MultiShop.Dtos.CatalogDtos.CategoryDtos.CreateCategoryDto

@{
  Layout = "_AdminLayout";
}


<section class="ms-page-head">
  <div><span class="ms-kicker">KATEGORİ YÖNETİMİ</span>
    <h1>Yeni kategori ekle</h1>
    <p>Kategori bilgilerini ve ürün oluştururken kullanılacak seçenek şablonlarını belirle.</p></div>
  <div class="ms-head-actions"><a class="ms-secondary" href="categories.html">Vazgeç</a>
    <button class="ms-primary" type="submit" form="categoryCreateForm"><i class="fa-solid fa-check"></i> Kategoriyi
      Kaydet
    </button>
  </div>
</section>

<form id="categoryCreateForm" class="ms-form-layout" asp-area="Admin" asp-action="Create" asp-controller="Category">
  
  @Html.AntiForgeryToken()
  
  <div class="ms-form-stack">
    <section class="ms-card ms-form-card">
      <div class="ms-form-title">
        <h2>Kategori bilgileri</h2>
        <p>Kategorinin mağazada kullanılacak temel bilgileri.</p>
      </div>
      <div class="ms-form-grid">
        <div class="ms-field full">
          <label>Kategori adı</label>
          <input class="ms-input" asp-for="@Model.CategoryName" placeholder="Örn. Ayakkabı">
        </div>
      </div>
    </section>

    @* <section class="ms-card ms-form-card"> *@
    @*   <div class="ms-form-title"><h2>Seçenek şablonları</h2> *@
    @*     <p>Bu kategori seçildiğinde ürün oluşturma ekranında önerilecek seçenekler.</p></div> *@
    @*   <div class="ms-checkbox-grid"> *@
    @*     <label class="ms-check"><input data-option-template value="Renk" type="checkbox" checked> Renk</label> *@
    @*     <label class="ms-check"><input data-option-template value="Beden" type="checkbox"> Beden</label> *@
    @*     <label class="ms-check"><input data-option-template value="Numara" type="checkbox" checked> Numara</label> *@
    @*     <label class="ms-check"><input data-option-template value="Hafıza" type="checkbox"> Hafıza</label> *@
    @*     <label class="ms-check"><input data-option-template value="Kapasite" type="checkbox"> Kapasite</label> *@
    @*     <label class="ms-check"><input data-option-template value="Paket" type="checkbox"> Paket</label> *@
    @*   </div> *@
    @* </section> *@
  </div>

  <aside class="ms-form-stack">
    <section class="ms-card ms-form-card">
      <div class="ms-form-title">
        <h2>Önizleme</h2>
        <p>Liste ekranında kategori bu yapıda görünür.</p></div>
      <div class="ms-cell">
        <span class="ms-cell-icon"><i class="fa-solid fa-layer-group"></i></span>
        <div><strong class="ms-category-preview-name" data-preview-name>Yeni Kategori</strong>
          <small
            class="ms-category-preview-slug" data-preview-slug>kategori-slug</small></div>
      </div>
      <div class="ms-chips" data-preview-chips style="margin-top:14px"><span>Renk</span><span>Numara</span></div>
    </section>

    <div class="ms-form-footer">
      <a class="ms-secondary" asp-area="Admin" asp-controller="Category" asp-action="Index">Vazgeç</a>
      <button class="ms-primary" type="submit">
        <i class="fa-solid fa-check"></i> Kategoriyi Kaydet
      </button>
    </div>
  </aside>
</form>
