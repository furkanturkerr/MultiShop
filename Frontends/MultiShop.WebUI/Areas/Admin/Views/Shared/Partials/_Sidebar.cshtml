@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    string NavClass(params string[] controllers) =>
        controllers.Any(controller => string.Equals(controller, currentController, StringComparison.OrdinalIgnoreCase))
            ? "active"
            : string.Empty;
}

<aside class="ms-sidebar">
    <a class="ms-brand" asp-area="Admin" asp-controller="Category" asp-action="Index">
        <span class="ms-brand-badge">MS</span>
        <span class="ms-brand-copy">
            <strong>MultiShop</strong>
            <span>Yönetim Paneli</span>
        </span>
    </a>

    <div class="ms-sidebar-menu">
        <section class="ms-nav-group">
            <div class="ms-nav-label">KATALOG</div>
            <nav class="ms-nav" aria-label="Katalog yönetimi">
                <a class="@NavClass("Category")" asp-area="Admin" asp-controller="Category" asp-action="Index">
                    <span class="ms-nav-icon"><i class="fa-solid fa-layer-group"></i></span>
                    <span>Kategoriler</span>
                </a>
                <a class="@NavClass("Product", "ProductDetail", "ProductImage")"
                   asp-area="Admin" asp-controller="Product" asp-action="ProductList">
                    <span class="ms-nav-icon"><i class="fa-solid fa-box-open"></i></span>
                    <span>Ürünler</span>
                </a>
                <a class="@NavClass("Brand")" asp-area="Admin" asp-controller="Brand" asp-action="Index">
                    <span class="ms-nav-icon"><i class="fa-solid fa-tags"></i></span>
                    <span>Markalar</span>
                </a>
            </nav>
        </section>

        <section class="ms-nav-group">
            <div class="ms-nav-label">KAMPANYALAR</div>
            <nav class="ms-nav" aria-label="Kampanya yönetimi">
                <a class="@NavClass("Coupon")" asp-area="Admin" asp-controller="Coupon" asp-action="Index">
                    <span class="ms-nav-icon"><i class="fa-solid fa-ticket"></i></span>
                    <span>Kuponlar</span>
                </a>
                <a class="@NavClass("OfferDiscount")"
                   asp-area="Admin" asp-controller="OfferDiscount" asp-action="Index">
                    <span class="ms-nav-icon"><i class="fa-solid fa-percent"></i></span>
                    <span>İndirim Alanları</span>
                </a>
                <a class="@NavClass("SpecialOffer")"
                   asp-area="Admin" asp-controller="SpecialOffer" asp-action="Index">
                    <span class="ms-nav-icon"><i class="fa-solid fa-bullhorn"></i></span>
                    <span>Özel Teklifler</span>
                </a>
            </nav>
        </section>

        <section class="ms-nav-group">
            <div class="ms-nav-label">ANA SAYFA</div>
            <nav class="ms-nav" aria-label="Ana sayfa içeriği yönetimi">
                <a class="@NavClass("FeatureSlider")"
                   asp-area="Admin" asp-controller="FeatureSlider" asp-action="Index">
                    <span class="ms-nav-icon"><i class="fa-solid fa-images"></i></span>
                    <span>Ana Sayfa Sliderı</span>
                </a>
                <a class="@NavClass("Featured")" asp-area="Admin" asp-controller="Featured" asp-action="Index">
                    <span class="ms-nav-icon"><i class="fa-solid fa-star"></i></span>
                    <span>Vitrin Özellikleri</span>
                </a>
            </nav>
        </section>

        <section class="ms-nav-group">
            <div class="ms-nav-label">MÜŞTERİ İŞLEMLERİ</div>
            <nav class="ms-nav" aria-label="Müşteri işlemleri">
                <a class="@NavClass("Comment")" asp-area="Admin" asp-controller="Comment" asp-action="Index">
                    <span class="ms-nav-icon"><i class="fa-solid fa-comments"></i></span>
                    <span>Ürün Yorumları</span>
                </a>
                <a class="@NavClass("CargoCustomer")"
                   asp-area="Admin" asp-controller="CargoCustomer" asp-action="Index">
                    <span class="ms-nav-icon"><i class="fa-solid fa-address-book"></i></span>
                    <span>Müşteri Adresleri</span>
                </a>
            </nav>
        </section>

        <section class="ms-nav-group ms-nav-group-system">
            <div class="ms-nav-label">LOJİSTİK</div>
            <nav class="ms-nav" aria-label="Lojistik yönetimi">
                <a class="@NavClass("CargoCompany")"
                   asp-area="Admin" asp-controller="CargoCompany" asp-action="Index">
                    <span class="ms-nav-icon"><i class="fa-solid fa-truck-fast"></i></span>
                    <span>Kargo Şirketleri</span>
                </a>
            </nav>
        </section>

        <section class="ms-nav-group ms-nav-group-system">
            <div class="ms-nav-label">SİSTEM</div>
            <nav class="ms-nav" aria-label="Sistem bağlantıları">
                <a asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="ms-nav-icon"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
                    <span>Mağazayı Görüntüle</span>
                </a>
            </nav>
        </section>
    </div>

    <div class="ms-sidebar-footer">
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <button class="ms-sidebar-logout" type="submit">
                <span class="ms-nav-icon"><i class="fa-solid fa-arrow-right-from-bracket"></i></span>
                <span>Çıkış Yap</span>
            </button>
        </form>
    </div>
</aside>
