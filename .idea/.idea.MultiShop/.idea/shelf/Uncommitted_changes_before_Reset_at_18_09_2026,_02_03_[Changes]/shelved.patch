+<script>
+    document.addEventListener("DOMContentLoaded", function () {
+
+        const categoryName =
+            document.querySelector(
+                "[data-category-name]"
+            );
+
+        const slugInput =
+            document.querySelector(
+                "[data-category-slug]"
+            );
+
+        const presetButtons =
+            Array.from(
+                document.querySelectorAll(
+                    "[data-option-preset]"
+                )
+            );
+
+        const customInput =
+            document.querySelector(
+                "[data-option-custom]"
+            );
+
+        const addButton =
+            document.querySelector(
+                "[data-option-add]"
+            );
+
+        const selectedContainer =
+            document.querySelector(
+                "[data-selected-options]"
+            );
+
+        const hiddenContainer =
+            document.querySelector(
+                "[data-option-hidden-container]"
+            );
+
+        const emptyMessage =
+            document.querySelector(
+                "[data-option-empty]"
+            );
+
+        const counter =
+            document.querySelector(
+                "[data-option-count]"
+            );
+
+
+        /*
+         * Post validation sonrası Model'den gelen
+         * OptionTemplates değerlerini alıyoruz.
+         */
+        const selectedOptions =
+            Array.from(
+                hiddenContainer.querySelectorAll(
+                    'input[name="OptionTemplates"]'
+                )
+            )
+            .map(function (input) {
+                return input.value;
+            });
+
+
+        let slugEditedManually =
+            slugInput.value.trim().length > 0;
+
+
+        /* =====================================================
+           SLUG
+           ===================================================== */
+
+        function createSlug(value) {
+
+            return value
+                .toLocaleLowerCase("tr-TR")
+
+                .replaceAll("ç", "c")
+                .replaceAll("ğ", "g")
+                .replaceAll("ı", "i")
+                .replaceAll("ö", "o")
+                .replaceAll("ş", "s")
+                .replaceAll("ü", "u")
+
+                .replace(/[^a-z0-9]+/g, "-")
+                .replace(/^-+|-+$/g, "");
+
+        }
+
+
+        categoryName?.addEventListener(
+            "input",
+            function () {
+
+                if (
+                    slugEditedManually
+                ) {
+                    return;
+                }
+
+                slugInput.value =
+                    createSlug(
+                        categoryName.value
+                    );
+
+            }
+        );
+
+
+        slugInput?.addEventListener(
+            "input",
+            function () {
+
+                slugEditedManually =
+                    slugInput.value.trim().length > 0;
+
+                const start =
+                    slugInput.selectionStart;
+
+                slugInput.value =
+                    createSlug(
+                        slugInput.value
+                    );
+
+                try {
+
+                    slugInput.setSelectionRange(
+                        start,
+                        start
+                    );
+
+                }
+                catch {
+                }
+
+            }
+        );
+
+
+        /* =====================================================
+           OPTIONS
+           ===================================================== */
+
+        function normalizeOption(value) {
+
+            return value
+                .trim()
+                .replace(/\s+/g, " ");
+
+        }
+
+
+        function containsOption(value) {
+
+            return selectedOptions.some(
+                function (option) {
+
+                    return option
+                            .toLocaleLowerCase("tr-TR") ===
+                        value
+                            .toLocaleLowerCase("tr-TR");
+
+                }
+            );
+
+        }
+
+
+        function addOption(value) {
+
+            value =
+                normalizeOption(value);
+
+            if (!value) {
+                return;
+            }
+
+            if (containsOption(value)) {
+                return;
+            }
+
+            selectedOptions.push(value);
+
+            renderOptions();
+
+        }
+
+
+        function removeOption(value) {
+
+            const index =
+                selectedOptions.findIndex(
+                    function (option) {
+
+                        return option === value;
+
+                    }
+                );
+
+            if (index !== -1) {
+
+                selectedOptions.splice(
+                    index,
+                    1
+                );
+
+            }
+
+            renderOptions();
+
+        }
+
+
+        function renderOptions() {
+
+            selectedContainer.innerHTML =
+                "";
+
+            hiddenContainer.innerHTML =
+                "";
+
+
+            selectedOptions.forEach(
+                function (option) {
+
+                    /* visual tag */
+
+                    const item =
+                        document.createElement(
+                            "span"
+                        );
+
+                    item.className =
+                        "ad-selected-option";
+
+
+                    const text =
+                        document.createElement(
+                            "span"
+                        );
+
+                    text.textContent =
+                        option;
+
+
+                    const remove =
+                        document.createElement(
+                            "button"
+                        );
+
+                    remove.type =
+                        "button";
+
+                    remove.innerHTML =
+                        "×";
+
+                    remove.setAttribute(
+                        "aria-label",
+                        option + " seçeneğini kaldır"
+                    );
+
+
+                    remove.addEventListener(
+                        "click",
+                        function () {
+
+                            removeOption(
+                                option
+                            );
+
+                        }
+                    );
+
+
+                    item.appendChild(text);
+
+                    item.appendChild(remove);
+
+                    selectedContainer.appendChild(
+                        item
+                    );
+
+
+                    /* hidden input */
+
+                    const hidden =
+                        document.createElement(
+                            "input"
+                        );
+
+                    hidden.type =
+                        "hidden";
+
+                    hidden.name =
+                        "OptionTemplates";
+
+                    hidden.value =
+                        option;
+
+                    hiddenContainer.appendChild(
+                        hidden
+                    );
+
+                }
+            );
+
+
+            /* preset active */
+
+            presetButtons.forEach(
+                function (button) {
+
+                    const value =
+                        button.dataset
+                            .optionPreset;
+
+                    button.classList.toggle(
+                        "is-selected",
+                        containsOption(value)
+                    );
+
+                }
+            );
+
+
+            counter.textContent =
+                selectedOptions.length;
+
+
+            emptyMessage.style.display =
+                selectedOptions.length === 0
+                    ? "block"
+                    : "none";
+
+        }
+
+
+        /* =====================================================
+           PRESETS
+           ===================================================== */
+
+        presetButtons.forEach(
+            function (button) {
+
+                button.addEventListener(
+                    "click",
+                    function () {
+
+                        const value =
+                            button.dataset
+                                .optionPreset;
+
+
+                        if (
+                            containsOption(value)
+                        ) {
+
+                            removeOption(value);
+
+                        }
+                        else {
+
+                            addOption(value);
+
+                        }
+
+                    }
+                );
+
+            }
+        );
+
+
+        /* =====================================================
+           CUSTOM OPTION
+           ===================================================== */
+
+        function addCustomOption() {
+
+            if (!customInput) {
+                return;
+            }
+
+            addOption(
+                customInput.value
+            );
+
+            customInput.value =
+                "";
+
+            customInput.focus();
+
+        }
+
+
+        addButton?.addEventListener(
+            "click",
+            addCustomOption
+        );
+
+
+        customInput?.addEventListener(
+            "keydown",
+            function (event) {
+
+                if (
+                    event.key !== "Enter"
+                ) {
+                    return;
+                }
+
+                event.preventDefault();
+
+                addCustomOption();
+
+            }
+        );
+
+
+        renderOptions();
+
+    });
+</script>
