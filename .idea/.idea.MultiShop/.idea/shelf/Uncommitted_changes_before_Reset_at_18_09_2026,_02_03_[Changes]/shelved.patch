+<script>
+    document.addEventListener("DOMContentLoaded", function () {
+
+        const category =
+            document.querySelector("[data-msh-category]");
+
+        const categoryButton =
+            document.querySelector("[data-msh-category-button]");
+
+        const mobileButton =
+            document.querySelector("[data-msh-mobile]");
+
+        const nav =
+            document.querySelector("[data-msh-nav]");
+
+
+        function closeCategory() {
+
+            if (!category || !categoryButton) {
+                return;
+            }
+
+            category.classList.remove("is-open");
+
+            categoryButton.setAttribute(
+                "aria-expanded",
+                "false"
+            );
+        }
+
+
+        categoryButton?.addEventListener(
+            "click",
+            function (event) {
+
+                event.stopPropagation();
+
+                const open =
+                    category.classList.toggle(
+                        "is-open"
+                    );
+
+                categoryButton.setAttribute(
+                    "aria-expanded",
+                    open ? "true" : "false"
+                );
+            }
+        );
+
+
+        mobileButton?.addEventListener(
+            "click",
+            function () {
+
+                if (!nav) {
+                    return;
+                }
+
+                const open =
+                    nav.classList.toggle(
+                        "is-mobile-open"
+                    );
+
+                mobileButton.setAttribute(
+                    "aria-expanded",
+                    open ? "true" : "false"
+                );
+            }
+        );
+
+
+        document.addEventListener(
+            "click",
+            function (event) {
+
+                if (
+                    category &&
+                    !category.contains(event.target)
+                ) {
+                    closeCategory();
+                }
+            }
+        );
+
+
+        document.addEventListener(
+            "keydown",
+            function (event) {
+
+                if (event.key !== "Escape") {
+                    return;
+                }
+
+                closeCategory();
+
+                nav?.classList.remove(
+                    "is-mobile-open"
+                );
+
+                mobileButton?.setAttribute(
+                    "aria-expanded",
+                    "false"
+                );
+            }
+        );
+
+    });
+</script>
