+@model List<MultiShop.Dtos.CatologDtos.CategoryDtos.ResultCategoryDto>
+
+<form class="ms-filters" method="get" action="shop.html" aria-label="Ürün filtreleri" data-source="api/Categories">
+  <div class="ms-filter-heading">
+    <div><span>Ürünleri daralt</span>
+      <h2>Filtreler</h2></div>
+    <a href="shop.html">Temizle</a></div>
+  <fieldset>
+    <legend>Kategori</legend>
+    <div class="ms-filter-options">
+      
+      @foreach (var item in Model)
+      {
+        <label>
+          <input type="checkbox" name="@item.CategoryId" value="@item.CategoryName">
+          <span>@item.CategoryName</span>
+        </label>
+      }
+    </div>
+  </fieldset>
+  <fieldset>
+    <legend>Fiyat aralığı</legend>
+    <div class="ms-filter-options">
+      <label>
+        <input type="radio" name="price" value="all"
+               checked><span>Tüm fiyatlar</span></label>
+      <label>
+        <input type="radio"
+               name="price"
+               value="0-1000"><span>0–1.000 TL</span></label>
+      <label>
+        <input
+          type="radio" name="price" value="1000-3000"><span>1.000–3.000 TL</span></label>
+      <label>
+        <input type="radio"
+               name="price"
+               value="3000+"><span>3.000 TL ve üzeri</span></label>
+    </div>
+  </fieldset>
+  <button class="ms-filter-submit" type="submit">Filtreleri uygula</button>
+</form>
