+document.addEventListener("DOMContentLoaded", function () {
+    const nav = document.querySelector(".ad-nav");
+
+    if (!nav) return;
+
+    const links = Array.from(nav.querySelectorAll("a"));
+
+    function clearActive() {
+        links.forEach(link => {
+            link.classList.remove("is-active");
+            link.removeAttribute("aria-current");
+        });
+    }
+
+    function setActive(link) {
+        clearActive();
+
+        link.classList.add("is-active");
+        link.setAttribute("aria-current", "page");
+    }
+
+    function normalizePath(path) {
+        if (!path) return "/";
+
+        const normalized = path
+            .replace(/\/+/g, "/")
+            .replace(/\/$/, "")
+            .toLowerCase();
+
+        return normalized || "/";
+    }
+
+    function detectActiveLink() {
+        const currentPath = normalizePath(window.location.pathname);
+        const currentHash = window.location.hash;
+
+        let matchedLink = null;
+
+        links.forEach(link => {
+            const rawHref = link.getAttribute("href");
+
+            if (!rawHref) return;
+
+            if (rawHref.startsWith("#")) {
+                if (currentHash && rawHref === currentHash) {
+                    matchedLink = link;
+                }
+
+                return;
+            }
+
+            const url = new URL(link.href, window.location.origin);
+            const linkPath = normalizePath(url.pathname);
+
+            if (
+                linkPath === currentPath &&
+                (!url.hash || url.hash === currentHash)
+            ) {
+                matchedLink = link;
+            }
+        });
+
+        if (!matchedLink && !currentHash) {
+            const dashboardLink = links.find(link => {
+                const rawHref = link.getAttribute("href");
+
+                return rawHref === "index.html" ||
+                    rawHref === "/" ||
+                    rawHref === "/Admin" ||
+                    rawHref === "/Admin/";
+            });
+
+            if (dashboardLink) {
+                matchedLink = dashboardLink;
+            }
+        }
+
+        if (matchedLink) {
+            setActive(matchedLink);
+        }
+    }
+
+    detectActiveLink();
+    
+    links.forEach(link => {
+        link.addEventListener("click", function () {
+            setActive(link);
+        });
+    });
+    window.addEventListener("hashchange", function () {
+        detectActiveLink();
+    });
+});
